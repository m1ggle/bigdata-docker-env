# =============================================================================
#  大数据开发环境 - 环境变量模板
#  复制为 .env 后按需修改:  cp .env.example .env
# =============================================================================

# --- PostgreSQL (Hive Metastore backend) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=metastore

# Hive metastore DB 用户密码 (会被注入 hive-site.xml)
HIVE_DB_PASS=hive123

# --- 版本信息 (与各 Dockerfile / compose 保持一致, 便于阅读) ---
HADOOP_VERSION=3.3.6
HIVE_VERSION=3.1.3
SPARK_VERSION=3.4.3
HUDI_VERSION=0.14.1
FLINK_VERSION=1.18.1
KAFKA_VERSION=3.7.0
